<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Le calendrier de l'Avent de la Forge — DRANE Hauts-de-France</title>
<style>
:root{
  --nuit:#0f1d3a; --nuit2:#18294f; --or:#e8b94a; --or2:#f6d98b; --rouge:#c8102e;
  --creme:#fff8ec; --texte:#1d2433; --vert:#1f6f54;
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
  background:radial-gradient(ellipse at top,var(--nuit2),var(--nuit) 70%);
  color:var(--creme); min-height:100vh; overflow-x:hidden;
}
/* Neige */
.neige{position:fixed;inset:0;pointer-events:none;z-index:0}
.flocon{position:absolute;top:-10px;color:#fff;opacity:.7;animation:tomber linear infinite}
@keyframes tomber{to{transform:translateY(105vh) translateX(30px)}}
@media (prefers-reduced-motion:reduce){.flocon{display:none}}

header{position:relative;z-index:1;text-align:center;padding:2.2rem 1rem 1rem}
header .sur{letter-spacing:.2em;text-transform:uppercase;font-size:.8rem;color:var(--or2)}
header h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.8rem,4.5vw,3rem);margin:.4rem 0;color:#fff}
header h1 span{color:var(--or)}
header p{max-width:720px;margin:.6rem auto 0;line-height:1.5;opacity:.9}
.legende{display:flex;gap:1.2rem;justify-content:center;flex-wrap:wrap;margin-top:1rem;font-size:.85rem;opacity:.85}
.legende b{color:var(--or2)}
.compteur{margin-top:.8rem;font-size:.95rem;color:var(--or2)}

main{position:relative;z-index:1;max-width:1150px;margin:0 auto;padding:1rem 1rem 3rem}
.grille{display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:14px}
.case{
  position:relative;aspect-ratio:1/1.05;border-radius:14px;overflow:hidden;
  background:var(--creme);color:var(--texte);box-shadow:0 6px 18px rgba(0,0,0,.35);
  user-select:none;-webkit-user-select:none;
}
.case:nth-child(4n+2){grid-row:span 1}
.face{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:.8rem;text-align:center;gap:.35rem}
.face .num{font-family:Georgia,serif;font-size:1rem;color:var(--rouge);font-weight:700}
.face .ico{font-size:2.2rem;line-height:1}
.face .nom{font-weight:700;font-size:1.05rem}
.face .theme{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--vert)}
.face button{margin-top:.3rem;border:0;background:var(--nuit);color:#fff;border-radius:999px;padding:.4rem .9rem;
  font-size:.82rem;cursor:pointer}
.face button:hover,.face button:focus-visible{background:var(--rouge);outline:3px solid var(--or);outline-offset:2px}
canvas.grattage{position:absolute;inset:0;width:100%;height:100%;cursor:crosshair;touch-action:none}
.verrou{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:linear-gradient(145deg,#2a3c66,#1a2848);color:#cfd8ee;text-align:center;padding:.8rem;gap:.3rem;
  border:2px dashed rgba(232,185,74,.35);border-radius:14px}
.verrou .grand{font-family:Georgia,serif;font-size:2.6rem;color:var(--or)}
.verrou small{font-size:.78rem;opacity:.85}
.aide-clavier{position:absolute;bottom:6px;left:0;right:0;text-align:center;z-index:2}
.aide-clavier button{font-size:.7rem;background:rgba(15,29,58,.75);color:#fff;border:0;border-radius:999px;padding:.2rem .6rem;cursor:pointer}
.aide-clavier button:focus-visible{outline:3px solid var(--or)}

/* Fenêtre */
.voile{position:fixed;inset:0;background:rgba(6,12,28,.75);display:none;align-items:center;justify-content:center;z-index:10;padding:1rem}
.voile.ouvert{display:flex}
.fenetre{background:var(--creme);color:var(--texte);border-radius:18px;max-width:640px;width:100%;max-height:92vh;overflow:auto;
  box-shadow:0 20px 60px rgba(0,0,0,.5);position:relative}
.fenetre .tete{background:var(--nuit);color:#fff;padding:1.3rem 1.5rem 1.1rem;border-bottom:4px solid var(--or)}
.fenetre .tete .jour{color:var(--or2);font-size:.85rem;letter-spacing:.12em;text-transform:uppercase}
.fenetre .tete h2{font-family:Georgia,serif;font-size:1.7rem;margin-top:.2rem}
.fenetre .corps{padding:1.2rem 1.5rem 1.5rem;line-height:1.55}
.fenetre .desc{font-size:1.05rem;margin-bottom:1rem}
.bloc{border-radius:12px;padding:.8rem 1rem;margin:.6rem 0}
.bloc h3{font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.25rem}
.b1d{background:#e7f3ee}.b1d h3{color:var(--vert)}
.b2d{background:#e9eefb}.b2d h3{color:#2b4a9b}
.defi{background:#fdeccf;border:2px dashed var(--or)}.defi h3{color:#9a5b00}
.actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1rem}
.btn{display:inline-block;text-decoration:none;border:0;border-radius:999px;padding:.65rem 1.2rem;font-weight:600;cursor:pointer;font-size:.95rem}
.btn-or{background:var(--rouge);color:#fff}.btn-or:hover{background:#a00d25}
.btn-sec{background:#e3e6ee;color:var(--texte)}
.btn:focus-visible{outline:3px solid var(--or);outline-offset:2px}
.fermer{position:absolute;top:.7rem;right:.8rem;background:transparent;border:0;color:#fff;font-size:1.6rem;cursor:pointer;line-height:1}
.fermer:focus-visible{outline:3px solid var(--or)}

footer{position:relative;z-index:1;text-align:center;font-size:.8rem;opacity:.75;padding:0 1rem 2rem;line-height:1.6}
footer a{color:var(--or2)}
.bandeau-demo{position:fixed;bottom:0;left:0;right:0;background:var(--rouge);color:#fff;text-align:center;padding:.4rem;font-size:.85rem;z-index:5}
/* Smartphones et petites tablettes */
@media (max-width:600px){
  header{padding:1.4rem .8rem .6rem}
  header p{font-size:.92rem}
  .legende{gap:.5rem;font-size:.78rem}
  main{padding:.6rem .6rem 3rem}
  .grille{grid-template-columns:repeat(3,1fr);gap:8px}
  .case{border-radius:10px}
  .face{padding:.4rem;gap:.15rem}
  .face .num{font-size:.72rem}
  .face .ico{font-size:1.5rem}
  .face .nom{font-size:.78rem;line-height:1.15}
  .face .theme{display:none}
  .face button{font-size:.68rem;padding:.25rem .55rem}
  .verrou .grand{font-size:1.8rem}
  .verrou small{font-size:.66rem}
  .aide-clavier button{font-size:.62rem;padding:.15rem .45rem}
  .fenetre .tete{padding:1rem 1.1rem .9rem}
  .fenetre .tete h2{font-size:1.35rem}
  .fenetre .corps{padding:1rem 1.1rem 1.2rem}
  .fenetre .desc{font-size:.98rem}
  .actions .btn{flex:1;text-align:center}
}
@media (max-width:340px){ .grille{grid-template-columns:repeat(2,1fr)} }
</style>
</head>
