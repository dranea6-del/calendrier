/* Disposition mélangée mais stable (comme un vrai calendrier) */
const ORDRE = [14,3,22,9,1,18,7,24,11,5,20,16,2,13,8,21,6,19,4,15,10,23,12,17];

const params = new URLSearchParams(location.search);
const DEMO = true;
const CLE = "avent-forge-drane-grattees";

function lireGrattees(){ try{ return JSON.parse(localStorage.getItem(CLE)||"[]"); }catch(e){ return []; } }
function sauverGrattees(l){ try{ localStorage.setItem(CLE, JSON.stringify(l)); }catch(e){} }
let grattees = lireGrattees();

function estOuverte(n){
  if (DEMO) return true;
  const now = new Date();
  const m = now.getMonth(), j = now.getDate();
  if (m === 11) return j >= n;        // décembre
  if (m === 0) return true;           // janvier : tout reste ouvert
  return false;
}

function joursAvant(n){
  const now = new Date();
  let y = now.getFullYear();
  const cible = new Date(y, 11, n);
  return Math.ceil((cible - new Date(y, now.getMonth(), now.getDate())) / 86400000);
}

const grille = document.getElementById("grille");

function creerCase(n){
  const o = OUTILS.find(x=>x.n===n);
  const el = document.createElement("div");
  el.className = "case";
  el.dataset.n = n;
  if (!estOuverte(n)){
    const d = joursAvant(n);
    el.innerHTML = `<div class="verrou" aria-label="Case ${n}, verrouillée">
      <div class="grand">${n}</div><div>🔒</div>
      <small>${d>0 ? (d===1?"Demain !":"Encore "+d+" jours") : "Patience…"}</small></div>`;
    return el;
  }
  el.innerHTML = `<div class="face">
      <div class="num">${n} décembre</div>
      <div class="ico" aria-hidden="true">${o.ico}</div>
      <div class="nom">${o.nom}</div>
      <div class="theme">${o.theme}</div>
      <button type="button" data-ouvrir="${n}">Découvrir</button>
    </div>`;
  if (!grattees.includes(n)){
    const c = document.createElement("canvas");
    c.className = "grattage";
    c.setAttribute("aria-hidden","true");
    el.appendChild(c);
    const aide = document.createElement("div");
    aide.className = "aide-clavier";
    aide.innerHTML = `<button type="button" aria-label="Ouvrir la case du ${n} décembre sans gratter">Ouvrir</button>`;
    el.appendChild(aide);
    aide.querySelector("button").addEventListener("click", ()=>reveler(el, n, true));
    requestAnimationFrame(()=>initGrattage(c, el, n));
  }
  return el;
}

function initGrattage(c, el, n){
  const r = el.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  c.width = r.width * dpr; c.height = r.height * dpr;
  const ctx = c.getContext("2d");
  ctx.scale(dpr, dpr);
  const g = ctx.createLinearGradient(0,0,r.width,r.height);
  g.addColorStop(0,"#f6d98b"); g.addColorStop(.5,"#e8b94a"); g.addColorStop(1,"#c9942a");
  ctx.fillStyle = g; ctx.fillRect(0,0,r.width,r.height);
  // paillettes
  for(let i=0;i<70;i++){
    ctx.fillStyle = `rgba(255,255,255,${Math.random()*.5})`;
    ctx.fillRect(Math.random()*r.width, Math.random()*r.height, 2, 2);
  }
  ctx.fillStyle = "#7a1020";
  ctx.textAlign = "center";
  const t = Math.max(.55, Math.min(1, r.width/170));
  ctx.font = `bold ${Math.round(46*t)}px Georgia, serif`;
  ctx.fillText(n, r.width/2, r.height/2 + 6*t);
  ctx.font = `600 ${Math.round(13*t)}px system-ui, sans-serif`;
  ctx.fillText(r.width < 130 ? "Grattez !" : "✨ Grattez-moi ✨", r.width/2, r.height/2 + 34*t);
  ctx.globalCompositeOperation = "destination-out";

  let actif = false, fini = false, compteur = 0;
  const pos = e => { const b = c.getBoundingClientRect(); return [e.clientX-b.left, e.clientY-b.top]; };
  const gratter = e => {
    if(!actif || fini) return;
    const [x,y] = pos(e);
    ctx.beginPath(); ctx.arc(x,y,Math.max(14, r.width/8),0,Math.PI*2); ctx.fill();
    if (++compteur % 8 === 0 && pourcentage() > 0.5){ fini = true; reveler(el, n, true); }
  };
  const pourcentage = () => {
    const d = ctx.getImageData(0,0,c.width,c.height).data;
    let vide = 0, total = 0;
    for(let i=3;i<d.length;i+=64){ total++; if(d[i]===0) vide++; }
    return vide/total;
  };
  c.addEventListener("pointerdown", e=>{ actif=true; c.setPointerCapture(e.pointerId); gratter(e); });
  c.addEventListener("pointermove", gratter);
  ["pointerup","pointercancel","pointerleave"].forEach(t=>c.addEventListener(t,()=>actif=false));
}

function reveler(el, n, ouvrir){
  const c = el.querySelector("canvas"); const a = el.querySelector(".aide-clavier");
  if (c){ c.style.transition="opacity .5s"; c.style.opacity="0"; setTimeout(()=>c.remove(),500); }
  if (a) a.remove();
  if (!grattees.includes(n)){ grattees.push(n); sauverGrattees(grattees); majCompteur(); }
  if (ouvrir) setTimeout(()=>ouvrirFenetre(n), 450);
}

const voile = document.getElementById("voile");
let dernierFocus = null;
function ouvrirFenetre(n){
  const o = OUTILS.find(x=>x.n===n);
  dernierFocus = document.activeElement;
  document.getElementById("f-jour").textContent = `Case du ${n} décembre · ${o.theme}`;
  document.getElementById("f-titre").textContent = `${o.ico} ${o.nom}`;
  document.getElementById("f-desc").textContent = o.desc;
  document.getElementById("f-1d").textContent = o.d1;
  document.getElementById("f-2d").textContent = o.d2;
  document.getElementById("f-defi").textContent = o.defi;
  document.getElementById("f-lien").href = o.url;
  voile.classList.add("ouvert");
  document.getElementById("f-lien").focus();
}
function fermerFenetre(){ voile.classList.remove("ouvert"); if(dernierFocus) dernierFocus.focus(); }
document.getElementById("fermer").addEventListener("click", fermerFenetre);
document.getElementById("f-ok").addEventListener("click", fermerFenetre);
voile.addEventListener("click", e=>{ if(e.target===voile) fermerFenetre(); });
document.addEventListener("keydown", e=>{ if(e.key==="Escape" && voile.classList.contains("ouvert")) fermerFenetre(); });
grille.addEventListener("click", e=>{
  const b = e.target.closest("[data-ouvrir]");
  if (b) ouvrirFenetre(+b.dataset.ouvrir);
});

function majCompteur(){
  const ouvertes = OUTILS.filter(o=>estOuverte(o.n)).length;
  const txt = ouvertes === 0
    ? `🎁 Première case le 1er décembre — encore ${joursAvant(1)} jour${joursAvant(1)>1?"s":""} de patience !`
    : `🎁 ${grattees.filter(n=>estOuverte(n)).length} case(s) grattée(s) sur ${ouvertes} disponible(s)`;
  document.getElementById("compteur").textContent = txt;
}

function construire(){ grille.innerHTML=""; ORDRE.forEach(n=>grille.appendChild(creerCase(n))); }
construire();
let largeur = window.innerWidth, minuterie;
window.addEventListener("resize", ()=>{
  if (Math.abs(window.innerWidth - largeur) < 40) return;   // ignore la barre d'adresse mobile
  largeur = window.innerWidth;
  clearTimeout(minuterie); minuterie = setTimeout(construire, 250);
});
majCompteur();

if (DEMO){
  const b = document.createElement("div");
  b.className = "bandeau-demo";
  b.textContent = "Mode démonstration : toutes les cases sont ouvertes (retirez ?demo de l'adresse pour le mode normal).";
  document.body.appendChild(b);
}

/* Neige */
const neige = document.getElementById("neige");
for(let i=0;i<40;i++){
  const f = document.createElement("div");
  f.className = "flocon"; f.textContent = "❄";
  f.style.left = Math.random()*100 + "vw";
  f.style.fontSize = (8 + Math.random()*14) + "px";
  f.style.animationDuration = (8 + Math.random()*12) + "s";
  f.style.animationDelay = (-Math.random()*20) + "s";
  neige.appendChild(f);
}
</script>
</body>
